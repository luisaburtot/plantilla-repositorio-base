# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Llave de la API de Gemini. Se crea en Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_llave_aqui

# Modelo que usa la aplicación. Tiene que estar registrado en PRECIOS_POR_MILLON
# (src/consumir_gemini.py) para que el costo se calcule bien.
# Registrados hoy: gemini-3.1-flash-lite, gemini-3.8-flash
# Por qué se eligió este: docs/decision-arquitectura.md
AI_MODEL=gemini-3.1-flash-lite
